{
    "name": "@cn-ui/svg-spinner",
    "version": "1.2.0",
    "description": "SVG Spinner Component for solid-js",
    "main": "dist/server.js",
    "typings": "dist/svg-spinner.tsx",
    "browser": "dist/client.js",
    "type": "module",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "node ./scripts/SVGToSolidComponent.mjs && vite build --mode server && vite build --mode client",
        "prepublish": "pnpm build"
    },
    "sideEffects": false,
    "keywords": [
        "solid-spinners",
        "solid-spinner",
        "solid",
        "solidjs",
        "loader",
        "loaders",
        "loading",
        "spinner",
        "spinners",
        "progress",
        "activity"
    ],
    "author": "KonghaYao",
    "license": "MIT",
    "dependencies": {
        "solid-js": "^1.0.0"
    },
    "devDependencies": {
        "@cn-ui/spinners": "^1.0.0"
    }
}
