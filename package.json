{
    "name": "cn-ui",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "main": "./dist/index.js",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "dev": "storybook dev -p 6006",
        "preview": "pnpx http-server storybook-static --port 6006 --silent",
        "type-check": "tsc -p tsconfig.node.json",
        "check": "biome check --apply ./ --diagnostic-level=error",
        "build:test": "pnpm --filter=@cn-ui/area-data build && pnpm --filter=@cn-ui/svg-spinner build && storybook build --test",
        "build-storybook": "pnpm --filter=@cn-ui/area-data build && pnpm --filter=@cn-ui/svg-spinner build && storybook build ",
        "test:update": "node ./script/snapshotSync.mjs download",
        "test": "test-storybook --updateSnapshot --skipTags=\"skip-test\" --ci --browsers chromium ",
        "prettier": "prettier --write packages/**/*.{json,less,md}",
        "build": "pnpm --filter \"*\" build && pnpm storybook build",
        "prepare": "husky install"
    },
    "dependencies": {
        "@cn-ui/area-data": "workspace:^",
        "@cn-ui/reactive": "workspace:^",
        "@cn-ui/univer": "workspace:^",
        "solid-js": "^1.9.1"
    },
    "devDependencies": {
        "@ant-design/colors": "^7.1.0",
        "@biomejs/biome": "1.7.0",
        "@joshwooding/vite-plugin-react-docgen-typescript": "^0.3.1",
        "@solidjs/testing-library": "^0.8.10",
        "@storybook/addon-a11y": "^8.3.5",
        "@storybook/addon-essentials": "^8.3.5",
        "@storybook/addon-interactions": "^8.3.5",
        "@storybook/addon-links": "^8.3.5",
        "@storybook/blocks": "^8.3.5",
        "@storybook/test": "^8.3.5",
        "@storybook/test-runner": "^0.18.2",
        "@testing-library/jest-dom": "^6.5.0",
        "@types/lodash": "^4.17.10",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^20.16.10",
        "@types/sortablejs": "^1.15.8",
        "@unocss/cli": "^0.58.9",
        "@unocss/reset": "^0.58.9",
        "@unocss/transformer-directives": "^0.58.9",
        "@vant/touch-emulator": "^1.4.0",
        "dotenv": "^16.4.5",
        "fs-extra": "^11.2.0",
        "glob": "^10.4.5",
        "hast-util-to-jsx-runtime": "^2.3.0",
        "husky": "^8.0.3",
        "jest-image-snapshot": "^6.4.0",
        "jsdom": "^22.1.0",
        "lint-staged": "^15.2.10",
        "lodash-es": "^4.17.21",
        "mockjs-ts": "^2.3.0",
        "release-it": "^17.7.0",
        "rollup-plugin-bundle-stats": "^4.15.1",
        "rollup-plugin-multi-input": "^1.5.0",
        "rollup-plugin-node-externals": "^7.1.3",
        "runes2": "^1.1.4",
        "storybook": "^8.3.5",
        "storybook-solidjs": "^1.0.0-beta.2",
        "storybook-solidjs-docgen": "workspace:^",
        "storybook-solidjs-vite": "^1.0.0-beta.2",
        "tar": "^7.4.3",
        "typescript": "^5.6.2",
        "unocss": "^0.58.9",
        "unocss-preset-chinese": "^0.3.3",
        "unocss-preset-theme": "^0.12.0",
        "vite": "^5.4.8",
        "vite-bundle-analyzer": "^0.9.4",
        "vite-plugin-dts": "^3.9.1",
        "vite-plugin-solid": "^2.10.2",
        "vite-plugin-wasm": "^3.3.0",
        "vitest": "^1.6.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": "biome check --diagnostic-level=error --apply ",
        "*.{css,md,mdx,json}": "prettier --ignore-unknown "
    }
}
